index-state: 2026-03-24T13:41:24Z
packages: .

write-ghc-environment-files: always
  -- necessary for doctest-parallell

-- solver hints for GHC boot libs:
--
-- hspec tend to have low/unrestricted bounds on boot libs, so, for `--prefer-oldest` runs, cut away some impossible dep trees up front
constraints:
    time         >= 1.12
  , process      >= 1.6.25
  , directory    >= 1.3.7
  , filepath     >= 1.4.2
  , deepseq      >= 1.4.8
  , bytestring   >= 0.11.5
  , stm          >= 2.5.1
  , mtl          >= 2.2.2
  , transformers >= 0.5.6
  , containers   >= 0.6.7
  , array        >= 0.5.4
  , binary       >= 0.8.9
  , unix         >= 2.7.3

if impl(ghc >= 9.14)
  allow-newer:
    , boring:base
